{
  "venvPath": ".",
  "venv": ".venv",
  "typeCheckingMode": "strict",
  "pythonVersion": "3.14",
  "include": ["."],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/.git",
    "**/.venv/**",
    "**/build/**",
    "**/dist/**",
    "**/data/**",
    "**/logs/**",
    "**/plugins/**",
    "**/typings/**"
  ]
}
